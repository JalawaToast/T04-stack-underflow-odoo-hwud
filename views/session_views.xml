<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_speech_therapy_session_list" model="ir.ui.view">
        <field name="name">speech.therapy.session.list</field>
        <field name="model">speech.therapy.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="child_id"/>
                <field name="exercise_id"/>
                <field name="duration"/>
                <field name="ai_score"/>
            </list>
        </field>
    </record>


    <record id="view_speech_therapy_session_form" model="ir.ui.view">
        <field name="name">speech.therapy.session.form</field>
        <field name="model">speech.therapy.session</field>

        <field name="arch" type="xml">

            <form>

                <header>

                    <button
                        name="action_analyze_speech"
                        string="Analyze Speech"
                        type="object"
                        class="btn-primary"/>

                </header>


                <sheet>

                    <group string="Session Information">

                        <group>
                            <field name="child_id"/>
                            <field name="exercise_id"/>
                            <field name="date"/>
                            <field name="duration"/>
                        </group>

                    </group>


                    <notebook>

                        <!-- RECORDING -->

                        <page string="Recording">

                            <group>

                                <field
                                    name="recording_filename"
                                    invisible="1"/>

                                <field
                                    name="recording"
                                    filename="recording_filename"/>

                            </group>

                        </page>


                        <!-- AI ANALYSIS -->

                        <page string="AI Analysis">

                            <group>

                                <group string="Result">

                                    <field name="ai_score"/>

                                    <field name="ai_transcription"/>

                                </group>


                                <group string="Pronunciation">

                                    <field name="ai_phoneme_error_rate"/>

                                    <field name="ai_word_error_rate"/>

                                </group>


                                <group string="AI Feedback">

                                    <field name="ai_feedback"/>

                                </group>

                            </group>

                        </page>


                        <!-- THERAPIST NOTES -->

                        <page string="Therapist Notes">

                            <field name="therapist_notes"/>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>


    <record id="action_speech_therapy_session" model="ir.actions.act_window">

        <field name="name">Sessions</field>

        <field name="res_model">speech.therapy.session</field>

        <field name="view_mode">list,form</field>

    </record>

</odoo>