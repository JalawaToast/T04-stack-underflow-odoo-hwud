<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- Exercise List View -->
    <record id="view_speech_therapy_exercise_list" model="ir.ui.view">
        <field name="name">speech.therapy.exercise.list</field>
        <field name="model">speech.therapy.exercise</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="target_sound"/>
                <field name="difficulty"/>
                <field name="active"/>
            </list>
        </field>
    </record>


    <!-- Exercise Form View -->
    <record id="view_speech_therapy_exercise_form" model="ir.ui.view">
        <field name="name">speech.therapy.exercise.form</field>
        <field name="model">speech.therapy.exercise</field>
        <field name="arch" type="xml">

            <form>

                <sheet>

                    <group string="Exercise Information">

                        <group>
                            <field name="name"/>
                            <field name="target_sound"/>
                            <field name="difficulty"/>
                            <field name="active"/>
                        </group>

                    </group>

                    <notebook>

                        <page string="Description">
                            <field name="description"/>
                        </page>

                        <page string="Instructions">
                            <field name="instructions"/>
                        </page>

                        <page string="Example">
                            <field name="example_phrase"/>
                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>


    <!-- Exercise Action -->
    <record id="action_speech_therapy_exercise" model="ir.actions.act_window">

        <field name="name">Exercises</field>

        <field name="res_model">speech.therapy.exercise</field>

        <field name="view_mode">list,form</field>

    </record>

</odoo>